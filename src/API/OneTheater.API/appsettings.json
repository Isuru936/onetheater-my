{
  "ConnectionStrings": {
    "Database": "Host=onetheater.database;Port=5432;Username=postgres;Password=postgres;Database=onetheater",
    "Cache": "onetheater.redis:6379"
  },
  "MessageBroker": {
    "Host": "rabbitmq://onetheater.rabbitmq",
    "Username": "guest",
    "Password": "guest",
    "VirtualHost": "/"
  },
  "Keycloak": {
    "realm": "onetheater",
    "auth-server-url": "http://localhost:8082/",
    "internal-auth-server-url": "http://onetheater.keycloak:8080/",
    "ssl-required": "external",
    "resource": "onetheater-api",
    "verify-token-audience": true,
    "credentials": {
      "secret": "80eBdiYWv6xF38CgsDVdFdmNScneC93N"
    },
    "confidential-port": 0,
    "policy-enforcer": {
      "credentials": {}
    }
  },
  "KeycloakAdminAPI": {
    "realm": "master",
    "auth-server-url": "http://onetheater.keycloak:8080/",
    "internal-auth-server-url": "",
    "ssl-required": "external",
    "resource": "admin-api-for-onetheater-realm",
    "credentials": {
      "secret": "jrn5Rlf89F8YDtR1KUNyh4203poBpLqi"
    },
    "confidential-port": 0
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://onetheater.seq:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "OneTheater.Api"
    }
  },
  "Authentication": {
    "DefaultScheme": "Bearer",
    "Schemes": {
      "Bearer": {
        "ValidAudiences": [ "onetheater-api" ],
        "RequireHttpsMetadata": true,
        "Authority": "http://onetheater:8082/realms/onetheater",
        "TokenValidationParameters": {
          "ValidateAudience": true,
          "ValidAudiences": [ "onetheater-api" ]
        }
      }
    }
  }
}
